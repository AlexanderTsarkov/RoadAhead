# Dependencies
node_modules/

# Build outputs
dist/
build/
coverage/

# Environment / secrets
.env
.env.*
!.env.example

# Local/private road data
# Full external datasets, generated datasets, and personal GPS tracks must stay local by default.
data/raw/*
data/processed/*
data/private/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/private/.gitkeep

# GPS / personal tracks
*.gpx
*.kml
*.fit

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS/editor files
.DS_Store
Thumbs.db
.idea/
.vscode/

# Python cache
__pycache__/
*.py[cod]
.venv/
venv/

# Temporary files
*.tmp
*.bak
