{
  "name": "roadahead-emulator",
  "version": "0.1.0",
  "private": true,
  "description": "RoadAhead Phase 0 web route emulator — first minimal vertical slice (Slice 3)",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "build:scenarios": "mkdir -p dist-scripts && tsc -p tsconfig.scripts.json",
    "scenario:sweep": "npm run build:scenarios && node dist-scripts/emulator/scenarios/runScenarioSweep.js"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "vite": "^5.4.0"
  }
}
