{
  "name": "roadahead-emulator",
  "version": "0.1.0",
  "private": true,
  "description": "RoadAhead Phase 0 web route emulator",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "build:scenarios": "tsc -p tsconfig.scripts.json",
    "scenario:sweep": "npm run build:scenarios && node dist-scripts/emulator/scenarios/runScenarioSweep.js",
    "prepare:route-events": "node scripts/prepareRouteEvents.mjs"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "typescript": "^5.4.5",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "leaflet": "^1.9.4"
  }
}
